# Optional — when set, the app initializes Supabase Auth instead of demo-only mode.
# Create a Supabase project and paste Project URL + anon key from Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Anthropic API key — two modes:
#
# 1. LOCAL DEMO (recommended for development):
#    Set VITE_ANTHROPIC_API_KEY in .env.local — the app calls the Anthropic
#    API directly from the browser (demo users get real AI, no Supabase needed).
#    The key is only in your local build and never committed.
#    Add to .env.local:  VITE_ANTHROPIC_API_KEY=sk-ant-...
#
# 2. PRODUCTION:
#    Leave VITE_ANTHROPIC_API_KEY unset. Set ANTHROPIC_API_KEY as a Supabase
#    Edge Function secret (dashboard → Edge Functions → Secrets). The browser
#    calls the claude-chat Edge Function with a Supabase JWT; the key never
#    ships in the JS bundle.
VITE_ANTHROPIC_API_KEY=

# Feature flags (read in src/lib/featureFlags.ts)
VITE_FEATURE_SHEETS_WRITEBACK=true
VITE_FEATURE_AI_IMPORT=true
VITE_LOG_LEVEL=info

# PostHog analytics (per-person tracking + session replay).
# Sign up at posthog.com → copy Project API Key from Project Settings.
# Without a key the app skips analytics entirely (no-op).
# Share links like https://your-domain.com/?u=alice — recipients show up
# in PostHog → Persons labeled by name with full session replay.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
